# N.I. ENGINEERING SERVICES — LARAVEL BACKEND PRODUCTION CONFIGURATION
# Production Backend Domain: https://api.niengineeringbd.com
# Production Filament Portal: https://manage.niengineeringbd.com

APP_NAME="N.I. Engineering Digital Platform"
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://api.niengineeringbd.com
FILAMENT_URL=https://manage.niengineeringbd.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

# PostgreSQL Managed Production Database
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=nies_production
DB_USERNAME=postgres.nies_project
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_SSLMODE=require

# Caching & Session Management
BROADCAST_DRIVER=log
CACHE_STORE=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# Redis Connection
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Storage Configuration (Cloudflare R2 / AWS S3 / DigitalOcean Spaces)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
AWS_BUCKET=nies-production-media
AWS_URL=https://media.niengineeringbd.com
AWS_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Queue Processing
QUEUE_CONNECTION=redis

# Rate Limiting Policies
API_RATE_LIMIT_STANDARD=60
API_RATE_LIMIT_MUTATION=15

# GitHub Deploy Webhook Integration (Auto-trigger Astro static build)
GITHUB_REPOSITORY="Naz365/frontend_for_Nies"
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
GITHUB_WEBHOOK_EVENT="cms_content_updated"
